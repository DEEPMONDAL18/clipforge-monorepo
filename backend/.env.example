# ====================================================
# ClipForge Backend Environment Variables
# ====================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Security & Rate Limiting
SECRET_KEY=super-secret-key-change-in-production
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Centralized Storage & Provider Configuration
# Options: 'local' | 's3' | 'r2' | 'azure' | 'gcs'
STORAGE_DRIVER=local
STORAGE_ROOT_DIR=./storage
STORAGE_TEMP_DIR=./storage/temp
UPLOAD_TEMP_DIR=./storage/uploads
LOGS_DIR=./storage/logs

MAX_FILE_SIZE_BYTES=5368709120 # 5 GB in Bytes
DEFAULT_CHUNK_SIZE_BYTES=5242880 # 5 MB Chunk Size Default
JOB_TTL_SECONDS=3600 # 1 Hour File Lifespan
WORKER_CONCURRENCY=2 # Number of concurrent BullMQ worker jobs
WORKER_JOB_TIMEOUT_MS=300000 # 5 Minutes per job timeout
MAX_JOB_RETRIES=3 # Maximum retries before moving to DLQ
CLEANUP_CRON_SCHEDULE="0 * * * *" # Every hour

# Supabase Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FFmpeg Executable Paths
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Logging
LOG_LEVEL=debug # debug | info | warn | error
