# ====================================================
# Stage 1: Build Stage
# ====================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace package files
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/ ./packages/
COPY backend/package.json ./backend/
COPY backend/tsconfig.json ./backend/

# Install workspace dependencies
RUN npm ci

# Copy backend source code
COPY backend/src ./backend/src

# Build shared package and backend TypeScript
RUN npm run build:shared && npm run build:backend

# ====================================================
# Stage 2: Production Stage
# ====================================================
FROM node:20-alpine AS runner

# Install FFmpeg and FFprobe binaries in Alpine Linux
RUN apk add --no-cache ffmpeg curl

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Copy workspace configuration and production dependencies
COPY package.json package-lock.json* ./
COPY packages/ ./packages/
COPY backend/package.json ./backend/

RUN npm ci --only=production

# Copy compiled artifacts from builder
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/backend/dist ./backend/dist

# Create storage directories for runtime files
RUN mkdir -p /app/storage/temp /app/storage/uploads /app/storage/logs

EXPOSE 4000

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

CMD ["node", "backend/dist/server.js"]
